# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$APP_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, test, stg, prod)
APP_ENV=development

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# Stripe のシークレットキー（テストは sk_test_...）。罰金の引き落としと支払い方法の登録に使う
# @type=string(startsWith=sk_)
STRIPE_SECRET_KEY=

# Stripe の Webhook の署名シークレット（whsec_...）。エンドポイントは <サーバーの URL>/stripe/webhook
# @type=string(startsWith=whsec_)
STRIPE_WEBHOOK_SECRET=

# Resend の API キー。空のときはメールを送らず、サーバーのログに出す
# @required=false
RESEND_API_KEY=

# 招待メールの送信元。Resend で認証したドメインのアドレスにする
# @sensitive=false @required=false
MAIL_FROM=ichiro <onboarding@resend.dev>
