{
  "name": "@ichiro/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio --config=drizzle.local.config.ts",
    "db:migrate:deploy": "drizzle-kit migrate",
    "db:seed": "bun run src/seed/run.ts",
    "db:seed:public-page": "bun run src/seed/public-page.ts",
    "db:seed:email-verification": "bun run src/seed/email-verification.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "libsql": "0.5.29",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ichiro/config": "workspace:*",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "^6.0.3",
    "varlock": "catalog:"
  }
}
